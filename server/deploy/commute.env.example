# On the VM this becomes /srv/apps/commute/deploy/.env (install.sh creates it on the
# first deploy). Never commit a filled-in copy. The two .p8 keys go in
# deploy/secrets/apns.p8 and deploy/secrets/maps.p8 next to it.

# Public name of the API. Its DNS record points at the host's "apps" Cloudflare
# Tunnel (cloudflared tunnel route dns apps <name>).
COMMUTE_DOMAIN=commute-api.leatham.net

APPLE_TEAM_ID=R53MF3F498
APP_BUNDLE_ID=net.leatham.mycommute
APNS_KEY_ID=
MAPS_KEY_ID=

# Rail Data Marketplace, Live Departure Board: the consumer key, not the secret.
RAIL_DATA_API_KEY=
# RAIL_DATA_LDBWS_URL=https://api1.raildata.org.uk/1010-live-departure-board-dep1_2/LDBWS/api/20220120

# Optional, raises the TfL rate limit.
TFL_APP_KEY=
